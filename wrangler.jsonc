// Cloudflare Workers（静的アセット）での公開設定。
// ビルド時に STATIC_EXPORT=1 を設定して out/ に書き出し、そのフォルダをそのまま配信する。
{
  "name": "ara-company",
  "compatibility_date": "2026-10-01",
  // 旧URLから独自ドメインへの 301 転送（worker.js）。すべてのリクエストを先に worker.js に通す。
  "main": "./worker.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
